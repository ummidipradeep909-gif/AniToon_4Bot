BOT_TOKEN=
BOT_MODE=polling
LOG_LEVEL=info
POLICY_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
DATABASE_URL=postgresql://anitoon4:change-me@localhost:5432/anitoon4
REDIS_URL=redis://localhost:6379/0
POLICY_SERVICE_HOST=0.0.0.0
POLICY_SERVICE_PORT=8000

# OpenAI assist mode. Set secrets only in your deployment secret manager.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=12

# Stable AES-256-GCM key; generate once with openssl rand -base64 32
CLONE_ENCRYPTION_KEY=
# Maximum number of registered clones across all owners (default 100; range 1-10000)
CLONE_MAX_BOTS=100
