# Copy to .env.production and keep it out of source control.
# Generate high-entropy URL-safe passwords with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX

# Use URL-encoded credentials in these connection URLs.
DATABASE_URL=postgresql://anitoon4:REPLACE_WITH_RANDOM_HEX@postgres:5432/anitoon4
POLICY_DATABASE_URL=postgresql://anitoon4:REPLACE_WITH_RANDOM_HEX@postgres:5432/anitoon4
REDIS_URL=redis://:REPLACE_WITH_RANDOM_HEX@redis:6379/0
POLICY_REDIS_URL=redis://:REPLACE_WITH_RANDOM_HEX@redis:6379/0

BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
# polling or webhook. Webhook requires HTTPS reverse proxy and both webhook secrets.
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_LISTEN_ADDR=:8080
WEBHOOK_SECRET_TOKEN=

# Generate once and escrow separately from the database backup:
# openssl rand -base64 32
# Never regenerate this key while encrypted clone credentials exist.
CLONE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Generate a separate random secret for bot-to-policy authentication.
AI_SERVICE_TOKEN=REPLACE_WITH_RANDOM_SECRET
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=12
CLONE_MAX_BOTS=100
LOG_LEVEL=info
